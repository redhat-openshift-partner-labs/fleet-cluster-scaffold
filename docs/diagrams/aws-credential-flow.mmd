  %% Cluster names must be unique in their first 21 characters.
  %% Isolation rule: no credential on a spoke may act on another cluster's resources.
  %% Installer key: credentialsMode Manual, so the installer key is never copied to the spoke.
  %% Pipeline step 2: build the manifests Secret with one Secret manifest per operator.
  %% Pipeline step 3: after install, set INFRA_ID_PLACEHOLDER and VPC_ID_PLACEHOLDER in the cluster's Policies and Roles.
  subgraph HUB["Hub cluster"]
    INST["Installer user<br/>&lt;name&gt;-ocp-installer"]
    OPS["6 operator users<br/>&lt;name&gt;-&lt;operator&gt;<br/>machine-api · cco-iam-ro · image-registry · ingress · cncc · ebs-csi"]
    ROLES["Node roles<br/>&lt;name&gt;-master-role · &lt;name&gt;-worker-role"]
    ISEC["Installer Secrets<br/>aws-credentials-raw · aws-credentials"]
    RAW["Operator key Secrets<br/>&lt;name&gt;-&lt;operator&gt;-credentials-raw"]
    MAN["Manifests Secret<br/>&lt;name&gt;-cloud-credentials-manifests"]
    CD["Hive ClusterDeployment"]
  end
  subgraph SPOKE["Spoke cluster"]
    OSEC["Operator Secrets<br/>one per operator, in its target namespace"]
  end
  INST -->|AccessKey| ISEC
  OPS -->|AccessKeys| RAW
  RAW -->|pipeline step 2| MAN
  ISEC -->|credentialsSecretRef| CD
  MAN -->|manifestsSecretRef| CD
  CD -->|Hive install| OSEC
  ROLES -->|iamRole| SPOKE
